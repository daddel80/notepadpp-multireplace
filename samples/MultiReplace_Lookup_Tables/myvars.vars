-- Base path: adjust to the folder of the lookup tables
local PATH = [[C:\MultiReplace\samples\MultiReplace_Lookup_Tables\]]

-- File names
local countryFile = "country.lkp"
local phonecodeFile = "phonecode.lkp"
local currencyFile = "currency.lkp"

-- Return table
return {
    countryPath = PATH .. countryFile,
    phonecodePath = PATH .. phonecodeFile,
    currencyPath = PATH .. currencyFile
}
